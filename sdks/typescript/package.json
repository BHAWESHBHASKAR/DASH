{
  "name": "dash-ts",
  "version": "0.2.0",
  "description": "Idiomatic TypeScript client for the DASH retrieval engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "dash",
    "embeddings",
    "retrieval",
    "rag",
    "openai-compatible"
  ],
  "author": "DASH Contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/BHAWESHBHASKAR/DASH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BHAWESHBHASKAR/DASH.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/BHAWESHBHASKAR/DASH/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
