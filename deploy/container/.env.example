# DASH local deployment secrets
# Copy this file to `.env` and fill in real values, or run
# `../../scripts/generate-secrets.sh` from this directory to create one
# automatically.
#
# Never commit `.env` to version control.

# Ingestion service authentication
DASH_INGEST_API_KEY=<generate-a-32-char-random-string>
DASH_INGEST_JWT_HS256_SECRET=<generate-a-64-char-random-string>

# Retrieval service authentication
DASH_RETRIEVAL_API_KEY=<generate-a-32-char-random-string>
DASH_RETRIEVAL_JWT_HS256_SECRET=<generate-a-64-char-random-string>

# OIDC / JWKS authentication (optional; set DASH_*_JWT_PROVIDER=oidc to enable)
# DASH_INGEST_JWT_PROVIDER=oidc
# DASH_INGEST_JWT_ISSUER=https://your-idp.example.com
# DASH_INGEST_JWT_AUDIENCE=dash-api
# DASH_INGEST_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# DASH_RETRIEVAL_JWT_PROVIDER=oidc
# DASH_RETRIEVAL_JWT_ISSUER=https://your-idp.example.com
# DASH_RETRIEVAL_JWT_AUDIENCE=dash-api
# DASH_RETRIEVAL_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# Scoped API keys with optional roles (admin, ingest, retrieve, read_only)
# key:tenant:role1,role2
# DASH_INGEST_API_KEY_SCOPES=<key>:<tenant>:ingest
# DASH_RETRIEVAL_API_KEY_SCOPES=<key>:<tenant>:retrieve,read_only

# Customer-managed encryption keys (optional; default is none)
# DASH_ENCRYPTION_PROVIDER=env
# DASH_ENCRYPTION_MASTER_KEY=<64-char-hex-or-base64>
#
# AWS KMS backed provider (requires pkg/encryption built with --features aws-kms)
# DASH_ENCRYPTION_PROVIDER=aws-kms
# DASH_AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:111111111111:key/...
# DASH_AWS_KMS_REGION=us-east-1
# DASH_ENCRYPTION_MASTER_KEY=<base64-wrapped-data-key-or-omit-to-generate>
# DASH_ENCRYPTION_WRAPPED_KEY_FILE=.dash-wrapped-key

# Optional: real semantic embeddings via Ollama (requires
# docker-compose.ollama.yml and the `ollama` compose profile)
# DASH_EMBEDDING_PROVIDER=ollama
# DASH_OLLAMA_ENDPOINT=http://ollama:11434/api/embeddings
# DASH_OLLAMA_MODEL=nomic-embed-text

# Optional: real semantic embeddings via OpenAI
# DASH_EMBEDDING_PROVIDER=openai
# DASH_OPENAI_API_KEY=<your-key>
# DASH_OPENAI_MODEL=text-embedding-3-small

# Optional: control log verbosity
# RUST_LOG=info,dash=debug
