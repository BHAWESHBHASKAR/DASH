# DASH local deployment secrets
# Copy this file to `.env` and fill in real values, or run
# `../../scripts/generate-secrets.sh` from this directory to create one
# automatically.
#
# Never commit `.env` to version control.

# Ingestion service authentication
DASH_INGEST_API_KEY=<generate-a-32-char-random-string>
DASH_INGEST_JWT_HS256_SECRET=<generate-a-64-char-random-string>

# Retrieval service authentication
DASH_RETRIEVAL_API_KEY=<generate-a-32-char-random-string>
DASH_RETRIEVAL_JWT_HS256_SECRET=<generate-a-64-char-random-string>

# Optional: control log verbosity
# RUST_LOG=info,dash=debug
