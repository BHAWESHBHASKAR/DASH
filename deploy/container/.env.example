# DASH local deployment secrets.
#
# Preferred: run `scripts/generate-secrets.sh`, which writes a ready-to-use
# `.env` (mode 0600) next to docker-compose.yml with random values.
#
# If you copy this file by hand, replace EVERY value below. The placeholders
# are deliberately rejected by the services' secret validation, so a file
# copied as-is will fail at startup instead of running with a known secret.
#
# Never commit `.env` to version control.

# Ingestion service authentication
DASH_INGEST_API_KEY=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_INGEST_JWT_HS256_SECRET=REPLACE-ME_run_scripts/generate-secrets.sh

# Retrieval service authentication
DASH_RETRIEVAL_API_KEY=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_RETRIEVAL_JWT_HS256_SECRET=REPLACE-ME_run_scripts/generate-secrets.sh

# Replication token: retrieval pulls the ingestion WAL with this bearer token.
# Both variables MUST hold the same value.
DASH_INGEST_REPLICATION_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_RETRIEVAL_REPLICATION_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh

# Control plane (started only with `--profile control-plane`). The router
# client token must match the control-plane token.
DASH_CONTROL_PLANE_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_ROUTER_CONTROL_PLANE_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh

# Published ports bind to 127.0.0.1 by default. Set to 0.0.0.0 only behind a
# TLS-terminating proxy.
# DASH_PUBLISH_ADDR=127.0.0.1

# Embedding provider for retrieval/ingestion: hash (default), openai, ollama.
# DASH_EMBEDDING_PROVIDER=hash

# OIDC / JWKS authentication (optional; set DASH_*_JWT_PROVIDER=oidc to enable)
# DASH_INGEST_JWT_PROVIDER=oidc
# DASH_INGEST_JWT_ISSUER=https://your-idp.example.com
# DASH_INGEST_JWT_AUDIENCE=dash-api
# DASH_INGEST_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
# DASH_RETRIEVAL_JWT_PROVIDER=oidc
# DASH_RETRIEVAL_JWT_ISSUER=https://your-idp.example.com
# DASH_RETRIEVAL_JWT_AUDIENCE=dash-api
# DASH_RETRIEVAL_JWT_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# Scoped API keys with optional roles (admin, ingest, retrieve, read_only)
# key:tenant:role1,role2
# DASH_INGEST_API_KEY_SCOPES=<key>:<tenant>:ingest
# DASH_RETRIEVAL_API_KEY_SCOPES=<key>:<tenant>:retrieve,read_only

# Customer-managed encryption keys (optional; default is none)
# DASH_ENCRYPTION_PROVIDER=env
# DASH_ENCRYPTION_MASTER_KEY=<64-char-hex-or-base64>

# Optional: control log verbosity
# RUST_LOG=info,dash=debug
