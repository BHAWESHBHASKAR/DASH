            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (route, le) (rate(dash_http_server_request_duration_seconds_bucket{job=~\"$job\",component=\"ingestion\",route=~\"ingest.*\"}[$__rate_interval])))",
