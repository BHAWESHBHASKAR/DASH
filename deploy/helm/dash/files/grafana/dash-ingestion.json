        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route, code) (rate(dash_http_server_requests_total{job=~\"$job\",component=\"ingestion\",code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{code}}",
          "refId": "A"
        }
      ]
    },
