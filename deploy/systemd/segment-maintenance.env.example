# /etc/dash/segment-maintenance.env
# Must point at the same directory as DASH_INGEST_SEGMENT_DIR in ingestion.env.
DASH_INGEST_SEGMENT_DIR=/var/lib/dash/ingestion/segments
DASH_INGEST_SEGMENT_MAINTENANCE_INTERVAL_MS=30000
DASH_INGEST_SEGMENT_GC_MIN_STALE_AGE_MS=60000

# Encryption at rest (docs/operations/encryption.md, off by default). Enable
# LoadCredential= in dash-segment-maintenance.service and uncomment this; the key file must not be
# readable by other users. For a key rotation load the old key as a second
# credential and list it in DASH_ENCRYPTION_PREVIOUS_KEY_FILES.
#DASH_ENCRYPTION_KEY_FILE=/run/credentials/dash-segment-maintenance.service/dash-kek
#DASH_ENCRYPTION_PREVIOUS_KEY_FILES=/run/credentials/dash-segment-maintenance.service/dash-kek-old
