# /etc/dash/ingestion.env (mode 0640, owner root:dash). Never commit real values.
# scripts/deploy_systemd.sh fills every REPLACE-ME placeholder with a random
# secret when it installs this file. Services refuse to start with
# placeholder or short (<32 chars) secrets.

# Listener. Bind to a public address only behind a TLS-terminating proxy.
DASH_INGEST_BIND=127.0.0.1:8081
DASH_INGEST_HTTP_WORKERS=8
DASH_INGEST_HTTP_QUEUE_CAPACITY=512

# Authentication
DASH_INGEST_API_KEY=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_INGEST_JWT_HS256_SECRET=REPLACE-ME_run_scripts/generate-secrets.sh
# Bearer token retrieval presents when pulling the WAL; must equal
# DASH_RETRIEVAL_REPLICATION_TOKEN in retrieval.env.
DASH_INGEST_REPLICATION_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh

# Persistence. Everything lives under the unit's StateDirectory
# (/var/lib/dash/ingestion), the only writable location. The WAL path is
# separate from retrieval's.
DASH_INGEST_WAL_PATH=/var/lib/dash/ingestion/wal/ingestion.wal
DASH_INGEST_PERSISTENCE_PATH=/var/lib/dash/ingestion/state/ingestion.redb
DASH_INGEST_SEGMENT_DIR=/var/lib/dash/ingestion/segments
DASH_INGEST_AUDIT_LOG_PATH=/var/lib/dash/ingestion/audit/ingestion.audit.jsonl

DASH_INGEST_WAL_SYNC_EVERY_RECORDS=1
DASH_INGEST_WAL_APPEND_BUFFER_RECORDS=1
DASH_INGEST_WAL_ASYNC_FLUSH_INTERVAL_MS=250
DASH_INGEST_WAL_BACKGROUND_FLUSH_ONLY=false
# Leave 0 when dash-segment-maintenance.service runs.
DASH_INGEST_SEGMENT_MAINTENANCE_INTERVAL_MS=0
DASH_CHECKPOINT_MAX_WAL_RECORDS=50000
DASH_CHECKPOINT_MAX_WAL_BYTES=52428800
DASH_STRICT_SECRETS=1
