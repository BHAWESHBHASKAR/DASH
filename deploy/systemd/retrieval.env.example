# /etc/dash/retrieval.env (mode 0640, owner root:dash). Never commit real values.
# scripts/deploy_systemd.sh fills every REPLACE-ME placeholder with a random
# secret when it installs this file.

# Listener. Bind to a non-loopback address only with TLS on (below) or
# behind a TLS-terminating proxy.
DASH_RETRIEVAL_BIND=127.0.0.1:8080
DASH_RETRIEVAL_HTTP_WORKERS=8
DASH_RETRIEVAL_HTTP_QUEUE_CAPACITY=512

# Native TLS (docs/operations/tls.md); same file layout as ingestion.env.
#DASH_RETRIEVAL_TLS_CERT_FILE=/etc/dash/tls/retrieval.crt
#DASH_RETRIEVAL_TLS_KEY_FILE=/etc/dash/tls/retrieval.key

# Authentication
DASH_RETRIEVAL_API_KEY=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_RETRIEVAL_JWT_HS256_SECRET=REPLACE-ME_run_scripts/generate-secrets.sh

# Data path: retrieval follows the ingestion service over HTTP. It keeps its
# own redb store; it does NOT share a WAL file with ingestion.
DASH_RETRIEVAL_REPLICATION_SOURCE_URL=http://127.0.0.1:8081
DASH_RETRIEVAL_REPLICATION_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh
# When ingestion runs on another host, enable TLS there and follow it over
# https://. The leader certificate is verified against the public roots plus
# this CA; the client certificate is presented for mutual TLS.
#DASH_RETRIEVAL_REPLICATION_SOURCE_URL=https://ingestion.internal:8081
#DASH_REPLICATION_CA_FILE=/etc/dash/tls/ca.crt
#DASH_REPLICATION_CLIENT_CERT_FILE=/etc/dash/tls/retrieval.crt
#DASH_REPLICATION_CLIENT_KEY_FILE=/etc/dash/tls/retrieval.key
DASH_RETRIEVAL_REPLICATION_POLL_INTERVAL_MS=250

# Persistence under the unit's StateDirectory (/var/lib/dash/retrieval).
# The redb path is a FILE path.
DASH_RETRIEVAL_PERSISTENCE_PATH=/var/lib/dash/retrieval/state/retrieval.redb
DASH_RETRIEVAL_REPLICATION_OFFSET_PATH=/var/lib/dash/retrieval/state/retrieval-replication.offset
DASH_RETRIEVAL_SEGMENT_DIR=/var/lib/dash/retrieval/segments
DASH_RETRIEVAL_AUDIT_LOG_PATH=/var/lib/dash/retrieval/audit/retrieval.audit.jsonl
DASH_STRICT_SECRETS=1

# Encryption at rest (docs/operations/encryption.md, off by default). Enable
# LoadCredential= in dash-retrieval.service and uncomment this; the key file must not be
# readable by other users. For a key rotation load the old key as a second
# credential and list it in DASH_ENCRYPTION_PREVIOUS_KEY_FILES.
#DASH_ENCRYPTION_KEY_FILE=/run/credentials/dash-retrieval.service/dash-kek
#DASH_ENCRYPTION_PREVIOUS_KEY_FILES=/run/credentials/dash-retrieval.service/dash-kek-old
#
# Or keep the key-encryption key in a key manager instead of a key file
# (leave DASH_ENCRYPTION_KEY_FILE unset; a local key listed in
# DASH_ENCRYPTION_PREVIOUS_KEY_FILES stays readable while migrating):
#DASH_ENCRYPTION_PROVIDER=vault
#DASH_ENCRYPTION_VAULT_ADDR=https://vault.example:8200
#DASH_ENCRYPTION_VAULT_TOKEN_FILE=/etc/dash/encryption/vault-token
#DASH_ENCRYPTION_VAULT_KEY=dash
#DASH_ENCRYPTION_VAULT_CA_FILE=/etc/dash/encryption/vault-ca.pem
# AWS KMS (credentials from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a web
# identity or the container credentials endpoint):
#DASH_ENCRYPTION_PROVIDER=aws-kms
#DASH_ENCRYPTION_AWS_KMS_KEY_ID=alias/dash
#DASH_ENCRYPTION_AWS_REGION=eu-west-1
