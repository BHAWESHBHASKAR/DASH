# /etc/dash/retrieval.env (mode 0640, owner root:dash). Never commit real values.
# scripts/deploy_systemd.sh fills every REPLACE-ME placeholder with a random
# secret when it installs this file.

# Listener. Bind to a public address only behind a TLS-terminating proxy.
DASH_RETRIEVAL_BIND=127.0.0.1:8080
DASH_RETRIEVAL_HTTP_WORKERS=8
DASH_RETRIEVAL_HTTP_QUEUE_CAPACITY=512

# Authentication
DASH_RETRIEVAL_API_KEY=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_RETRIEVAL_JWT_HS256_SECRET=REPLACE-ME_run_scripts/generate-secrets.sh

# Data path: retrieval follows the ingestion service over HTTP. It keeps its
# own redb store; it does NOT share a WAL file with ingestion.
DASH_RETRIEVAL_REPLICATION_SOURCE_URL=http://127.0.0.1:8081
DASH_RETRIEVAL_REPLICATION_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh
DASH_RETRIEVAL_REPLICATION_POLL_INTERVAL_MS=250

# Persistence under the unit's StateDirectory (/var/lib/dash/retrieval).
# The redb path is a FILE path.
DASH_RETRIEVAL_PERSISTENCE_PATH=/var/lib/dash/retrieval/state/retrieval.redb
DASH_RETRIEVAL_REPLICATION_OFFSET_PATH=/var/lib/dash/retrieval/state/retrieval-replication.offset
DASH_RETRIEVAL_SEGMENT_DIR=/var/lib/dash/retrieval/segments
DASH_RETRIEVAL_AUDIT_LOG_PATH=/var/lib/dash/retrieval/audit/retrieval.audit.jsonl
DASH_STRICT_SECRETS=1
