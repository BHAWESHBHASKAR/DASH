# /etc/dash/control-plane.env (mode 0640, owner root:dash). Never commit real values.
# scripts/deploy_systemd.sh fills the REPLACE-ME placeholder with a random secret.

DASH_CONTROL_PLANE_BIND=127.0.0.1:8090
DASH_CONTROL_PLANE_NODE_ID=control-plane-1
DASH_CONTROL_PLANE_TOKEN=REPLACE-ME_run_scripts/generate-secrets.sh

# Persistence under the unit's StateDirectory (/var/lib/dash/control-plane).
DASH_CONTROL_PLANE_STATE_PATH=/var/lib/dash/control-plane/control-plane.csv
DASH_CONTROL_PLANE_STATE_SHA256_PATH=/var/lib/dash/control-plane/control-plane.csv.sha256
DASH_CONTROL_PLANE_LEASE_PATH=/var/lib/dash/control-plane/control-plane.lease
DASH_STRICT_SECRETS=1
